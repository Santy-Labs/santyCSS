{
  "name": "santycss",
  "version": "2.9.1",
  "description": "Plain-English utility-first CSS framework — no build step, just classes",
  "main": "index.js",
  "types": "index.d.ts",
  "style": "dist/santy.css",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./css": "./dist/santy.css",
    "./css/start": "./dist/santy-start.css",
    "./css/core": "./dist/santy-core.css",
    "./css/variants": "./dist/santy-variants.css",
    "./css/components": "./dist/santy-components.css",
    "./css/animations": "./dist/santy-animations.css",
    "./css/email": "./dist/santy-email.css",
    "./css/reset": "./dist/santy-reset.css",
    "./css/layout": "./dist/santy-layout.css",
    "./css/flex": "./dist/santy-flex.css",
    "./css/grid": "./dist/santy-grid.css",
    "./css/spacing": "./dist/santy-spacing.css",
    "./css/sizing": "./dist/santy-sizing.css",
    "./css/typography": "./dist/santy-typography.css",
    "./css/colors": "./dist/santy-colors.css",
    "./css/borders": "./dist/santy-borders.css",
    "./css/effects": "./dist/santy-effects.css",
    "./css/themes": "./dist/santy-themes.css",
    "./classmap": "./dist/santy-classmap.json",
    "./min": "./dist/santy.min.css",
    "./postcss": "./postcss/index.js",
    "./jit": "./santy-jit.js",
    "./vite": "./vite-plugin-santycss.js",
    "./purge": "./lib/purge-core.js",
    "./migrate": "./migrate.js",
    "./scroll": "./dist/santy-scroll.js",
    "./js": "./dist/santy.js",
    "./behavior": "./dist/santy.js",
    "./elements": "./dist/santy-elements.js",
    "./merge": "./packages/merge/santy-merge.js",
    "./react": "./packages/react/index.js",
    "./vue": "./packages/vue/index.js"
  },
  "files": [
    "dist/",
    "postcss/",
    "lib/",
    "index.js",
    "index.d.ts",
    "build.js",
    "cli.js",
    "santy-jit.js",
    "santy.js",
    "packages/",
    "vite-plugin-santycss.js",
    "purge.js",
    "migrate.js",
    "README.md"
  ],
  "bin": {
    "santycss": "./cli.js",
    "santycss-migrate": "./migrate.js"
  },
  "keywords": [
    "css",
    "framework",
    "utility-css",
    "tailwind-alternative",
    "tailwind-migration",
    "plain-english",
    "ai-friendly",
    "dark-mode",
    "no-build",
    "santycss",
    "postcss",
    "vite"
  ],
  "scripts": {
    "build": "node build.js",
    "test": "node build.js && node test/run-tests.js",
    "purge": "node purge.js",
    "dev": "node build.js && echo 'Watching...'",
    "prepublishOnly": "node build.js && node test/run-tests.js"
  },
  "peerDependencies": {
    "postcss": ">=8.0.0",
    "react": ">=17.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "author": "Santy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChintuSanty/santyCSS.git"
  },
  "homepage": "https://santycss.santy.in",
  "bugs": {
    "url": "https://github.com/ChintuSanty/santyCSS/issues"
  }
}
